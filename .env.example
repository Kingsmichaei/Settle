# Copy to .env and adjust. Every setting is optional for local development.

SETTLE_ENVIRONMENT=development

# SQLite locally. In production, e.g. postgresql+psycopg://user:password@host:5432/settle
SETTLE_DATABASE_URL=sqlite:///./settle.db

# Run the background worker inside the API process (one terminal is enough).
SETTLE_EMBEDDED_WORKER=true

# Where the frontend runs (used for PayPal return links and CORS).
SETTLE_PUBLIC_BASE_URL=http://localhost:5173

# ---- payments -----------------------------------------------------------------------
# "fake" needs nothing. For the PayPal sandbox, create an app at developer.paypal.com.
SETTLE_PAYMENT_PROVIDER=fake
# SETTLE_PAYMENT_PROVIDER=paypal
# SETTLE_PAYPAL_CLIENT_ID=
# SETTLE_PAYPAL_CLIENT_SECRET=
# SETTLE_PAYPAL_WEBHOOK_ID=

SETTLE_PLATFORM_FEE_BPS=1500
SETTLE_PAYOUT_HOLD_HOURS=24
SETTLE_FX_RATES={"USD:EUR": "0.92", "USD:GBP": "0.79", "USD:NGN": "1550"}

# ---- AI -----------------------------------------------------------------------------
# "none" runs every agent on its rule-based fallback. For Gemini, get a free key at
# https://aistudio.google.com/apikey and set the two lines below.
SETTLE_AI_PROVIDER=none
# SETTLE_AI_PROVIDER=gemini
# SETTLE_GEMINI_API_KEY=
# SETTLE_AI_MODEL=gemini-3.5-flash-lite

# ---- auth ---------------------------------------------------------------------------
# Required in production: a long random string.
# SETTLE_JWT_SECRET=
